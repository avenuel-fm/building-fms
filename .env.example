# 잠실점 에비뉴엘 시설물 및 배관 관제 시스템 (FMS) 환경 설정

# 1. 주 데이터베이스: Supabase 설정
# Supabase 대시보드 -> Project Settings -> API에서 확인 가능합니다.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. 백업 데이터베이스: Google Drive 설정
# 주간 풀(Full) 및 변경분(Incremental) 백업 JSON 파일이 자동 업로드될 구글 드라이브 폴더 ID입니다.
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J
# Google Drive API 접근 토큰 (또는 Service Account Key)
GOOGLE_DRIVE_ACCESS_TOKEN=ya29.a0AfH6SMB...

# 3. 로컬 서버 포트 (기본값: 8080)
